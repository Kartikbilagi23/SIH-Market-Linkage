generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FARMER
  BUYER
}

enum ProduceUnit {
  KG
  QUINTAL
  TON
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  CANCELLED
}

enum OrderStatus {
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}


model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  produce Produce[]
  offers  Offer[]
  buyerOrders  Order[] @relation("BuyerOrders")
  farmerOrders Order[] @relation("FarmerOrders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Produce {
  id          String      @id @default(cuid())
  farmerId    String
  cropName    String
  quantity    Float
  unit        ProduceUnit
  quality     String?
  harvestDate DateTime?

  farmer  User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  listing Listing?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
}

model Listing {
  id                String        @id @default(cuid())
  produceId         String        @unique
  pricePerUnit      Float
  availableQuantity Float
  status            ListingStatus @default(ACTIVE)

  produce Produce @relation(fields: [produceId], references: [id], onDelete: Cascade)
  offers  Offer[]
  orders  Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Offer {
  id        String @id @default(cuid())
  listingId String
  buyerId   String
  order     Order?

  offeredQuantity Float
  offeredPrice    Float

  status  OfferStatus @default(PENDING)
  message String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id])

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
}

model Order {
  id            String      @id @default(cuid())

  offerId       String      @unique
  listingId     String
  buyerId       String
  farmerId      String

  quantity      Float
  agreedPrice   Float
  totalAmount   Float

  status        OrderStatus @default(CONFIRMED)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  offer         Offer       @relation(fields: [offerId], references: [id])
  listing       Listing     @relation(fields: [listingId], references: [id])
  buyer         User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  farmer        User        @relation("FarmerOrders", fields: [farmerId], references: [id])

  @@index([buyerId])
  @@index([farmerId])
  @@index([listingId])
  @@index([status])
}