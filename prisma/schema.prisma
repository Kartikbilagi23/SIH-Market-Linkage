generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FARMER
  BUYER
}

enum ProduceUnit {
  KG
  QUINTAL
  TON
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  CANCELLED
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  DELAYED
  CANCELLED
}

enum OrderStatus {
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CertificateType {
  QUALITY
  ORGANIC
  FARMER_CERTIFICATE
  LAB_REPORT
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  produce      Produce[]
  offers       Offer[]
  buyerOrders  Order[]   @relation("BuyerOrders")
  farmerOrders Order[]   @relation("FarmerOrders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Produce {
  id          String      @id @default(cuid())
  farmerId    String
  cropName    String
  quantity    Float
  unit        ProduceUnit
  quality     String?
  harvestDate DateTime?

  farmer      User          @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  listing     Listing?
  certificate Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
}

model Listing {
  id                String        @id @default(cuid())
  produceId         String        @unique
  pricePerUnit      Float
  availableQuantity Float
  status            ListingStatus @default(ACTIVE)

  produce Produce @relation(fields: [produceId], references: [id], onDelete: Cascade)
  offers  Offer[]
  orders  Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Offer {
  id        String @id @default(cuid())
  listingId String
  buyerId   String
  order     Order?

  offeredQuantity Float
  offeredPrice    Float

  status  OfferStatus @default(PENDING)
  message String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id])

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
}

model Order {
  id String @id @default(cuid())

  offerId   String @unique
  listingId String
  buyerId   String
  farmerId  String

  quantity    Float
  agreedPrice Float
  totalAmount Float
  shipment    Shipment?

  status OrderStatus @default(CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer   Offer   @relation(fields: [offerId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id])
  farmer  User    @relation("FarmerOrders", fields: [farmerId], references: [id])

  @@index([buyerId])
  @@index([farmerId])
  @@index([listingId])
  @@index([status])
}

model Shipment {
  id String @id @default(cuid())

  orderId String @unique

  carrier        String?
  trackingNumber String  @unique

  pickupLocation   String
  deliveryLocation String

  currentLocation String?
  status          ShipmentStatus @default(CREATED)

  estimatedDelivery DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order          Order           @relation(fields: [orderId], references: [id])
  trackingEvents TrackingEvent[]

  @@index([status])
}

model TrackingEvent {
  id String @id @default(cuid())

  shipmentId String

  status      ShipmentStatus
  location    String
  description String?

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([createdAt])
}

model Certificate {
  id String @id @default(cuid())

  uploadedBy String

  documentType CertificateType
  fileName     String

  cid     String
  ipfsUri String

  createdAt DateTime @default(now())

  produceId String

  produce Produce @relation(fields: [produceId], references: [id], onDelete: Cascade)

  @@index([produceId])
  @@index([cid])
}
